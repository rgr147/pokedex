# Arquivos de dependência
# Geralmente, o diretório onde os pacotes do Node.js são instalados.
node_modules/

# Arquivos de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Arquivos de configuração de ambiente
.env
.env.local

# Arquivos de configuração de editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Arquivos gerados pelo sistema operacional
.DS_Store
Thumbs.db

# Arquivos de backup ou versões antigas
*_old.html
*.bak